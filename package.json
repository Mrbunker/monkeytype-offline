{
  "name": "monkeytype-local-practice",
  "version": "26.32.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-static.mjs",
    "preinstall": "npx only-allow pnpm",
    "dev:source": "pnpm build:packages && pnpm --filter @monkeytype/frontend dev",
    "build:packages": "pnpm --filter '@monkeytype/frontend^...' run build",
    "build": "pnpm build:packages && pnpm --filter @monkeytype/frontend build",
    "preview": "pnpm --filter @monkeytype/frontend start",
    "test": "pnpm --filter @monkeytype/frontend test",
    "lint": "pnpm --filter @monkeytype/frontend lint",
    "lint:packages": "pnpm --filter './packages/*' lint",
    "check-assets": "pnpm --filter @monkeytype/frontend check-assets",
    "format-check": "oxfmt . --check",
    "format-fix": "oxfmt .",
    "lint-styles": "stylelint \"frontend/src/styles/**/*.{scss,css}\"",
    "test:packages": "pnpm --filter './packages/*' --if-present test",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "19.2.2",
    "@types/node": "24.9.1",
    "@vitest/coverage-v8": "4.1.5",
    "caniuse-lite": "1.0.30001778",
    "conventional-changelog": "8.1.3",
    "husky": "8.0.1",
    "knip": "2.19.2",
    "lint-staged": "13.2.3",
    "only-allow": "1.2.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.7.1",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "vitest": "4.1.0",
    "yaml": "2.8.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx,js}": [
      "oxlint --type-aware --type-check --format agent"
    ],
    "*.{scss,css}": [
      "stylelint"
    ]
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
